# Database to query. Use the read-only user created by db/readonly_user.sql.
# DATABASE_URL=mysql+pymysql://pricequery_ro:<password>@localhost/pricedb
# default: sqlite demo database created by `python -m pricequery.seed`

# Needed only to turn plain-English questions into SQL (pip install -r requirements-llm.txt)
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# MAX_ROWS=100
# QUERY_TIMEOUT_SECONDS=5
# BLOCKED_IDENTIFIERS=email
